PORT=3000
# REQUIRED in production, 32+ random characters (openssl rand -hex 48). The app refuses to start with a weak value.
SESSION_SECRET=

# Session store: admin sessions use Redis when reachable; otherwise in-memory (not for multi-instance without Redis).
# Local Node: redis://localhost:6379 — Docker Compose app container uses redis://redis:6379 (set in docker-compose.yml).
REDIS_URL=redis://localhost:6379

# PostgreSQL (must match Docker POSTGRES_USER / POSTGRES_PASSWORD — default superuser is "postgres")
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=company_db
# Optional: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=

# Admin panel credentials (used when admin_user row is first created)
ADMIN_USERNAME=admin
# Used only when the admin account is first created. 12+ characters; production refuses weak/default passwords.
# Change it later in Admin > Security, or with: npm run admin:reset-password
ADMIN_PASSWORD=

# Canonical site URL for sitemap.xml and newsletter unsubscribe links (no trailing slash)
SITE_URL=https://example.com

# Resend (https://resend.com) — required for admin “Send newsletter”
RESEND_API_KEY=
# Verified sender, e.g. Newsletters <newsletter@updates.yourdomain.com>
RESEND_FROM_EMAIL=

# --- Deployment / security ---
# Number of reverse proxies in front of the app (0 = app is exposed directly). Wrong values let clients spoof
# their IP and bypass rate limits, so only set TRUST_PROXY=1 when nginx/Caddy/a load balancer really sits in front.
TRUST_PROXY=0
# Admin cookies are Secure (HTTPS only) in production. Set to false ONLY for plain-HTTP internal testing.
# COOKIE_SECURE=false
# Docker Compose: interface the app port is published on (default localhost; use a reverse proxy for public access)
# BIND_ADDR=127.0.0.1
# Optional separate salt for hashing visitor IPs in analytics (defaults to SESSION_SECRET)
# ANALYTICS_IP_SALT=

# --- Production (docker-compose.prod.yml) ---
# Your domain WITHOUT https:// (e.g. myteam.duckdns.org). Caddy gets the HTTPS certificate for it.
# SITE_DOMAIN=
