PORT=3000
SESSION_SECRET=change-me-in-production

# Session store: admin sessions use Redis when reachable; otherwise in-memory (not for multi-instance without Redis).
# Local Node: redis://localhost:6379 — Docker Compose app container uses redis://redis:6379 (set in docker-compose.yml).
REDIS_URL=redis://localhost:6379

# PostgreSQL (must match Docker POSTGRES_USER / POSTGRES_PASSWORD — default superuser is "postgres")
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=company_db
# Optional: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=

# Admin panel credentials (used when admin_user row is first created)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Canonical site URL for sitemap.xml and newsletter unsubscribe links (no trailing slash)
SITE_URL=https://example.com

# Resend (https://resend.com) — required for admin “Send newsletter”
RESEND_API_KEY=
# Verified sender, e.g. Newsletters <newsletter@updates.yourdomain.com>
RESEND_FROM_EMAIL=
